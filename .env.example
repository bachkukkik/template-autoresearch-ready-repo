# Project env template — cp .env.example .env (or: python3 scripts/gen-env.py --fresh).
APP_NAME=myproject
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=myproject
DB_PASSWORD=changeme
DB_NAME=myproject

REDIS_URL=redis://localhost:6379

JWT_SECRET=changeme-min-16-chars
SESSION_SECRET=changeme-min-16-chars

EXTERNAL_API_KEY=changeme

# AUTH_BEARER_TOKEN gates every REST route but /health, and the /mcp surface; AUTH_DISABLED=1 is local-only.
AUTH_BEARER_TOKEN=changeme
AUTH_DISABLED=0

RESEARCH_JOBS_DB=data/jobs.db
RESEARCH_RUN_TIMEOUT=30
RESEARCH_MAX_CONCURRENT_JOBS=4
RESEARCH_WORKSPACES_DIR=data/workspaces
RESEARCH_CORPUS_ROOT=kb/raw
# Empty = only `replay`; the `command` adapter is never allowed over the API.
RESEARCH_ALLOWED_AGENTS=

# PR-Agent (optional; CI reads its own GitHub vars/secrets — never this file).
# These locals only mirror the names for hand-running the CLI. Placeholders only.
PR_AGENT_ENABLED=changeme
OPENAI_API_KEY=changeme
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=
