# Project Environment Variables
# Copy to .env and fill in values before starting services.
#
#   cp .env.example .env
#
# Required vars will fail-fast at startup if unset.
# Optional vars use safe defaults.

# ─── Application ────────────────────────────────────────────────
APP_NAME=myproject
NODE_ENV=development

# ─── Database ───────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=myproject
DB_PASSWORD=changeme
DB_NAME=myproject

# ─── Cache ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Secrets ────────────────────────────────────────────────────
JWT_SECRET=changeme-min-16-chars
SESSION_SECRET=changeme-min-16-chars

# ─── External Services ──────────────────────────────────────────
# Fill in before deploying to production
EXTERNAL_API_KEY=changeme

# ─── Autoresearch Service ───────────────────────────────────────
# Placeholder-only values — copy to .env and replace with real secrets.
# AUTH_BEARER_TOKEN gates every REST route (except /health) and the /mcp
# surface; AUTH_DISABLED=1 bypasses auth for local development only.
AUTH_BEARER_TOKEN=changeme
AUTH_DISABLED=0
# SQLite file backing the durable job store; created on first run.
# Relative paths resolve from the service root (WORKDIR /app in the container).
RESEARCH_JOBS_DB=data/jobs.db
# Per-run time budget (seconds) for the research workload subprocesses.
RESEARCH_RUN_TIMEOUT=30
# Cap on concurrent research jobs per process.
RESEARCH_MAX_CONCURRENT_JOBS=4
# Per-job isolated workspaces under autoresearch/service/data/ (gitignored).
RESEARCH_WORKSPACES_DIR=data/workspaces
# Root for params.corpus.files; the compose container overrides this to /kb-raw via the read-only mount.
RESEARCH_CORPUS_ROOT=kb/raw

# ─── PR-Agent (optional) ──────────────────────────────────────
# Opt-in AI code review on pull requests (PRD 18; workflow .github/workflows/pr-agent.yml).
# OFF by default — the workflow job is gated on the repo variable PR_AGENT_ENABLED.
# On GitHub: set the repository variable PR_AGENT_ENABLED=true and the secret
# OPENAI_API_KEY; optionally set variables OPENAI_BASE_URL (any OpenAI-compatible
# endpoint: LiteLLM gateway, cloud API, local vLLM) and OPENAI_DEFAULT_MODEL.
# Locally: fill these in .env and the pr-agent CLI (`pip install "pr-agent[github]"`)
# can review your branch before you open the PR. Placeholders below — never commit
# real values (scripts/gen-env.py copies comments verbatim into .env).
PR_AGENT_ENABLED=changeme
OPENAI_API_KEY=changeme
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=
