# Secrets and credentials are local-only; only .example shapes are tracked —
# plus the README that documents the directory (AGENTS.md §Security, secret-scan).
.env
.env.*
!.env.example
*.pem
*.key
*.p12
.credentials/*
!.credentials/*.example
!.credentials/*.example.*
!.credentials/README.md

node_modules/
dist/
build/
*.local

__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

docker-compose.override.yml

.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

*.log
logs/
test-results/
coverage/
.coverage
htmlcov/

# Run logs, the date-stamped loop output and the service's SQLite store stay
# untracked; the narrowed pattern keeps autoresearch/{contract,engine,README.md}
# and each directory's .gitkeep tracked.
results.tsv
autoresearch/*-[0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]/
autoresearch/service/data/*
!autoresearch/service/data/.gitkeep

scratchpads/*
!scratchpads/.gitkeep

# Harness-local runtime state; the symlinks into .agents/ stay tracked.
.claude/*
!.claude/skills
!.claude/plugins
!.claude/agents
!.claude/commands
.opencode/*
!.opencode/commands

# The doctrine is TRACKED (AGENTS.md funnel rule 10): never ignore AGENTS.md,
# PRD.md, docs/, kb/, tests/, .agents/, .github/ — ci.yml's `doctrine` job
# fails the build if any of them is ignored.

# codegraph and graphify artifacts are local-only; a directory rule beats
# enumerating them (the next artifact version would add untracked noise). To
# track the graph, un-ignore graphify-out/graph.json and add its merge driver.
.codegraph/
graphify-out/*

autoresearch/runs/*
!autoresearch/runs/.gitkeep
