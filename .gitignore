# === Environment & Secrets ===
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Live credentials directory — AGENTS.md §Security calls for a *gitignored*
# credentials dir; this is it. Real webhook specs, service-account JSON, tokens.
# Only `.example` shapes are ever tracked — plus the README that documents the
# directory — which is what ci.yml's secret-scan job asserts.
.credentials/*
!.credentials/*.example
!.credentials/*.example.*
# the tracked README explains the directory and points at example.json.example
!.credentials/README.md

# === Node.js ===
node_modules/
dist/
build/
*.local

# === Python ===
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# === Docker ===
docker-compose.override.yml

# === IDE & OS ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# === Logs ===
*.log
logs/

# === Test artifacts ===
test-results/
coverage/
.coverage
htmlcov/

# === Autoresearch loop ===
# upstream leaves the results log untracked (program.md §Logging results)
results.tsv

# === Runtime SQLite job store ===
# the service writes its jobs DB to data/jobs.db (RESEARCH_JOBS_DB default)
# — never show it in git status, whether created at the repo root or under service/
/data/*
!/data/.gitkeep
service/data/*
!service/data/.gitkeep

# === Agent scratch space ===
scratchpads/*
!scratchpads/.gitkeep

# === Harness-local dirs — the symlinks into .agents/ are tracked, runtime state is not ===
.claude/*
!.claude/skills
!.claude/plugins
!.claude/agents

# === The doctrine is TRACKED — do not add ignores for any of these ===
# AGENTS.md, PRD.md, docs/, kb/, tests/, .agents/, .github/ and the harness symlinks
# are versioned artifacts, not local scaffolding (AGENTS.md funnel rule 10). kb/ in
# particular is funnel stage 2-3: kb/raw/ is immutable source material and the layer-2
# pages ground every PRD — unused material is archived to kb/_archive/, never deleted,
# never ignored.
#
# Ignoring any of them empties the funnel for every agent working from a fresh clone,
# and leaves the tracked .claude/* symlinks dangling once .agents/ stops being
# committed. The `doctrine` job in .github/workflows/ci.yml fails the build if it
# happens, so a local override here will not go unnoticed.

# === codegraph local index (local SQLite artifact; upstream ignores the whole dir) ===
# ignore everything inside, keep the directory's tracked placeholder
.codegraph/*
!.codegraph/.gitkeep
# NB: codegraph re-creates .codegraph/.gitignore on every validating command. It is left
# untracked on purpose — never commit it, and never stage .codegraph/ with a blanket add.

# === graphify knowledge graph ===
# Default: the graph is LOCAL — untracked, rebuilt on demand. Ignore the whole
# directory by rule rather than enumerating artifacts: a run leaves a root marker,
# detect/ast/semantic/chunk files, caches and, across a version bump, date-stamped
# pre-upgrade backup directories. Enumerating them guarantees the next artifact
# version adds untracked noise and tempts a blanket `git add`.
graphify-out/*
# Tracking the graph? Un-ignore it AND register the merge driver in .gitattributes:
#   !graphify-out/graph.json
